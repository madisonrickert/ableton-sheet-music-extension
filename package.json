{
  "name": "ableton-sheet-music-extension",
  "version": "1.2.0",
  "description": "View an Ableton Live MIDI clip as sheet music, transpose it for any instrument, and export MusicXML / PDF / PNG.",
  "license": "MIT",
  "main": "dist/extension.js",
  "engines": {
    "node": ">=24.14.1"
  },
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "setup": "node scripts/setup-sdk.mjs && pnpm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "build:ui": "vite build",
    "build:dev": "pnpm run build:ui && pnpm run typecheck && tsx build.ts",
    "build": "pnpm run build:ui && pnpm run typecheck && tsx build.ts --production",
    "start": "pnpm run build:dev && extensions-cli run --storage-directory \"$PWD/.dev/storage\" --temp-directory \"$PWD/.dev/temp\"",
    "package": "pnpm run build && node scripts/package.mjs",
    "dev:ui": "vite"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli.tgz",
    "@types/node": "^26.1.1",
    "esbuild": "0.28.1",
    "jspdf": "^4.2.1",
    "opensheetmusicdisplay": "^2.0.0",
    "rollup-plugin-license": "^3.6.0",
    "svg2pdf.js": "^2.7.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^4.1.10"
  }
}
